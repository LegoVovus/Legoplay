# ============================================================
#  Environment Configuration
#  Copy this file to .env and fill in your actual values
# ============================================================

# ---------- Database ----------
DATABASE_URL=postgres://legoplay:yourpassword@postgres:5432/legoplay
POSTGRES_USER=legoplay
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=legoplay

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- Authentication ----------
PRIVATE_BETTER_AUTH_SECRET=generate_a_long_random_secret_here
# Must be the public origin of your site, e.g. https://legoplay.lordpipon.com
PUBLIC_BETTER_AUTH_URL=https://legoplay.lordpipon.com

# Google OAuth (optional — email + password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---------- Site identity (for forking) ----------
PUBLIC_SITE_NAME=LegoPlay
PUBLIC_SITE_ORIGIN=https://legoplay.lordpipon.com
PUBLIC_SITE_DESCRIPTION=LegoPlay is a free crypto trading simulator. Create coins, trade on liquidity pools, predict markets, and play arcade games with virtual money.
PUBLIC_SITE_CONTACT_EMAIL=contact@legoplay.lordpipon.com
PUBLIC_DISCORD_INVITE=
PUBLIC_GITHUB_REPO=https://github.com/lordpipon/catplay
PUBLIC_ADSENSE_CLIENT=
# Extra allowed request origins, comma-separated. Localhost is always allowed.
PUBLIC_TRUSTED_ORIGINS=https://legoplay.lordpipon.com

# ---------- First admin bootstrap ----------
# Set to the email of the account that should become HEAD ADMIN the first
# time it exists. Granted automatically by the scheduler exactly once.
# Remove it once your account is confirmed.
BOOTSTRAP_ADMIN_EMAIL=

# ---------- File Upload Storage (local disk under /app/uploads in Docker) ----------
PUBLIC_B2_BUCKET=uploads
PUBLIC_B2_ENDPOINT=
PUBLIC_B2_REGION=us-east-1

# ---------- Payments (optional) ----------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
PUBLIC_POLAR_PRODUCT_GEMS_500=
PUBLIC_POLAR_PRODUCT_GEMS_1300=
PUBLIC_POLAR_PRODUCT_GEMS_2800=
PUBLIC_POLAR_PRODUCT_GEMS_8000=

# ---------- AI (hopium question resolution) ----------
OPENROUTER_API_KEY=

# ---------- Web push notifications ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@legoplay.lordpipon.com
PUBLIC_VAPID_PUBLIC_KEY=

# ---------- Changelog/announcement Discord webhook ----------
# Optional. If set, resolved hopium questions & lottery draws are posted here.
DISCORD_WEBHOOK_URL=

# ---------- Lottery scheduled draw authorization ----------
# Any shared secret that authorizes the scheduled lottery draw endpoint.
LOTTERY_DRAW_SECRET=

# ---------- Chat encryption ----------
# Optional. Falls back to PRIVATE_BETTER_AUTH_SECRET if unset. Do NOT change
# after messages have been sent, or old chats can no longer be decrypted.
CHAT_ENCRYPTION_KEY=

# ---------- Websocket URL (client) ----------
PUBLIC_WEBSOCKET_URL=wss://legoplay.lordpipon.com/ws
